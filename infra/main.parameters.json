{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "alertEmail": {
      "value": "${ALERT_EMAIL}"
    },
    "budgetStartDate": {
      "value": "${BUDGET_START_DATE}"
    },
    "guardBudgetStartDate": {
      "value": "${GUARD_BUDGET_START_DATE}"
    },
    "cosmosMode": {
      "value": "${COSMOS_MODE=freeTier}"
    },
    "disabledTimers": {
      "value": "${DISABLED_TIMERS=}"
    },
    "entraTenantId": {
      "value": "${ENTRA_TENANT_ID=}"
    },
    "entraTenantSubdomain": {
      "value": "${ENTRA_TENANT_SUBDOMAIN=}"
    },
    "entraApiClientId": {
      "value": "${ENTRA_API_CLIENT_ID=}"
    },
    "entraAllowedClientIds": {
      "value": "${ENTRA_ALLOWED_CLIENT_IDS=}"
    },
    "entraRequiredScope": {
      "value": "${ENTRA_REQUIRED_SCOPE=access_as_user}"
    },
    "entraAdminRole": {
      "value": "${ENTRA_ADMIN_ROLE=admin}"
    },
    "hmacKey": {
      "value": "${MYNEWS_HMAC_KEY}"
    },
    "identityDeleteMode": {
      "value": "${IDENTITY_DELETE_MODE=manual}"
    },
    "minSupportedBuild": {
      "value": "${MIN_SUPPORTED_BUILD=0}"
    },
    "appleRenewBy": {
      "value": "${APPLE_SECRET_RENEW_BY=}"
    }
  }
}
