{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvonment.github.io/my-news/api/schemas/Error.schema.json",
  "title": "Error",
  "description": "The one error envelope. Clients route on error.code (docs/api.md §1.4); the status for each code is fixed by core/errors.py ERROR_STATUS. 410 is only account_deleted.",
  "x-phase": "P1",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "$ref": "Common.schema.json#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "English, for logs. Never shown to users; never exception text."
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "validation_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "fields"
                    ],
                    "properties": {
                      "fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "field",
                            "reason"
                          ],
                          "properties": {
                            "field": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            },
                            "reason": {
                              "$ref": "Common.schema.json#/$defs/ValidationReason"
                            }
                          },
                          "additionalProperties": false
                        },
                        "minItems": 1,
                        "maxItems": 50
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "reason"
                    ],
                    "properties": {
                      "reason": {
                        "$ref": "Common.schema.json#/$defs/ValidationReason"
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "invalid_token"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [],
                    "properties": {},
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "reason"
                    ],
                    "properties": {
                      "reason": {
                        "const": "expired"
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "consent_required"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "consentVersion"
                ],
                "properties": {
                  "consentVersion": {
                    "$ref": "Common.schema.json#/$defs/ConsentVersion"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "not_found"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "resource"
                ],
                "properties": {
                  "resource": {
                    "enum": [
                      "story",
                      "edition",
                      "section",
                      "tag",
                      "source",
                      "saved",
                      "suggestion",
                      "invite",
                      "user",
                      "deletion",
                      "report"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "duplicate"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "resource",
                  "id"
                ],
                "properties": {
                  "resource": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "limit_reached"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "resource",
                  "limit"
                ],
                "properties": {
                  "resource": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "state_conflict"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "account_deleted"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "deleting",
                      "deleted"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "payload_too_large"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "limitBytes"
                ],
                "properties": {
                  "limitBytes": {
                    "const": 65536
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "unsupported_media_type"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "expected"
                ],
                "properties": {
                  "expected": {
                    "const": "application/json"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "quota_exceeded"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "quota",
                  "limit",
                  "period",
                  "resetsAt"
                ],
                "properties": {
                  "quota": {
                    "$ref": "Common.schema.json#/$defs/QuotaKey"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "period": {
                    "enum": [
                      "day",
                      "week"
                    ]
                  },
                  "resetsAt": {
                    "$ref": "Common.schema.json#/$defs/Timestamp"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "auth_unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "enum": [
                      "config",
                      "jwks"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "degraded"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "dependency"
                ],
                "properties": {
                  "dependency": {
                    "enum": [
                      "database",
                      "queue",
                      "pool",
                      "model"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "invite_malformed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "unauthenticated"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "invite_required"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "account_blocked"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "admin_required"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "invite_not_found"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "invite_used"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "invite_expired"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "internal"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "error": {
        "code": "invite_required",
        "message": "An invite code is required to use MyNews.",
        "details": {}
      }
    },
    {
      "error": {
        "code": "validation_failed",
        "message": "Request validation failed.",
        "details": {
          "fields": [
            {
              "field": "settings.briefSize",
              "reason": "enum"
            }
          ]
        }
      }
    },
    {
      "error": {
        "code": "quota_exceeded",
        "message": "Daily limit reached.",
        "details": {
          "quota": "redeem",
          "limit": 10,
          "period": "day",
          "resetsAt": "2026-10-22T00:00:00Z"
        }
      }
    },
    {
      "error": {
        "code": "account_deleted",
        "message": "This account was deleted.",
        "details": {
          "state": "deleting"
        }
      }
    },
    {
      "error": {
        "code": "auth_unavailable",
        "message": "Authentication is unavailable.",
        "details": {
          "reason": "config"
        }
      }
    }
  ]
}
