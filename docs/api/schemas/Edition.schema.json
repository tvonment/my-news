{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvonment.github.io/my-news/api/schemas/Edition.schema.json",
  "title": "Edition",
  "description": "Draft (Phase 3; not registered before then). GET /brief. sections always lists must_know (<= 2), for_you and something_different (<= 1), in that order. Never padded.",
  "x-phase": "P3",
  "type": "object",
  "required": [
    "edition",
    "sections",
    "moreTodayCount"
  ],
  "properties": {
    "edition": {
      "type": "object",
      "required": [
        "id",
        "slot",
        "date",
        "publishedAt",
        "builtAt",
        "nextExpectedAt",
        "size",
        "readingMinutes",
        "readCount"
      ],
      "properties": {
        "id": {
          "$ref": "Common.schema.json#/$defs/EditionId"
        },
        "slot": {
          "$ref": "Common.schema.json#/$defs/Slot"
        },
        "date": {
          "$ref": "Common.schema.json#/$defs/Date"
        },
        "publishedAt": {
          "$ref": "Common.schema.json#/$defs/Timestamp"
        },
        "builtAt": {
          "$ref": "Common.schema.json#/$defs/Timestamp"
        },
        "nextExpectedAt": {
          "$ref": "Common.schema.json#/$defs/Timestamp"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "readingMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "readCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/EditionSection"
            }
          ],
          "properties": {
            "kind": {
              "const": "must_know"
            },
            "stories": {
              "maxItems": 2
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/EditionSection"
            }
          ],
          "properties": {
            "kind": {
              "const": "for_you"
            },
            "stories": {
              "maxItems": 15
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/EditionSection"
            }
          ],
          "properties": {
            "kind": {
              "const": "something_different"
            },
            "stories": {
              "maxItems": 1
            }
          }
        }
      ],
      "items": false
    },
    "moreTodayCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    }
  },
  "additionalProperties": false,
  "$defs": {
    "EditionSection": {
      "type": "object",
      "required": [
        "kind",
        "stories",
        "hiddenByFilters"
      ],
      "properties": {
        "kind": {
          "enum": [
            "must_know",
            "for_you",
            "something_different"
          ]
        },
        "stories": {
          "type": "array",
          "items": {
            "$ref": "StoryCard.schema.json"
          },
          "maxItems": 15
        },
        "hiddenByFilters": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
