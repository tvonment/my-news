{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvonment.github.io/my-news/api/schemas/HistoryList.schema.json",
  "title": "HistoryList",
  "description": "Draft (Phase 3; not registered before then). GET /me/history?days=: from open signals, newest first, pages of 50, at most 200.",
  "x-phase": "P3",
  "type": "object",
  "required": [
    "items",
    "nextCursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "storyId",
          "title",
          "url",
          "publisher",
          "openedAt"
        ],
        "properties": {
          "storyId": {
            "$ref": "Common.schema.json#/$defs/StoryId"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "url": {
            "$ref": "Common.schema.json#/$defs/Url"
          },
          "publisher": {
            "$ref": "Common.schema.json#/$defs/PublisherRef"
          },
          "openedAt": {
            "$ref": "Common.schema.json#/$defs/Timestamp"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "nextCursor": {
      "anyOf": [
        {
          "$ref": "Common.schema.json#/$defs/Cursor"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
