{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvonment.github.io/my-news/api/schemas/Me.schema.json",
  "title": "Me",
  "description": "GET /me, PATCH /me, POST /me/redeem (200/201) and Export.account. roles is copied from the validated token. Every settings key is always present.",
  "x-phase": "P1",
  "type": "object",
  "required": [
    "oid",
    "uid",
    "roles",
    "createdAt",
    "locale",
    "languages",
    "timeZone",
    "settings",
    "consent",
    "onboarding",
    "minBuild"
  ],
  "properties": {
    "oid": {
      "$ref": "Common.schema.json#/$defs/Oid"
    },
    "uid": {
      "$ref": "Common.schema.json#/$defs/Uid"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true,
      "description": "The token's roles claim, sorted."
    },
    "createdAt": {
      "$ref": "Common.schema.json#/$defs/Timestamp"
    },
    "locale": {
      "$ref": "Common.schema.json#/$defs/Locale"
    },
    "languages": {
      "$ref": "Common.schema.json#/$defs/Languages"
    },
    "timeZone": {
      "$ref": "Common.schema.json#/$defs/TimeZone"
    },
    "settings": {
      "$ref": "Common.schema.json#/$defs/Settings"
    },
    "consent": {
      "$ref": "Common.schema.json#/$defs/Consent"
    },
    "onboarding": {
      "type": "object",
      "required": [
        "completedAt"
      ],
      "properties": {
        "completedAt": {
          "anyOf": [
            {
              "$ref": "Common.schema.json#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "minBuild": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "oid": "4f0d6c1e-8a3b-4c2d-9e7f-1a2b3c4d5e6f",
      "uid": "3f9a1c0b7d2e4f6a8b1c3d5e7f9a0b2c",
      "roles": [],
      "createdAt": "2026-10-21T10:00:00Z",
      "locale": "de-CH",
      "languages": [
        "de",
        "en"
      ],
      "timeZone": "Europe/Zurich",
      "settings": {
        "briefSize": 12,
        "editions": [
          "morning",
          "midday",
          "evening"
        ],
        "somethingDifferent": true,
        "emphasis": "balanced",
        "openInReader": false,
        "summaryInList": true,
        "personalisedRanking": true,
        "historyRetentionDays": 90
      },
      "consent": {
        "aiProcessing": {
          "granted": false,
          "version": null
        }
      },
      "onboarding": {
        "completedAt": null
      },
      "minBuild": 0
    },
    {
      "oid": "4f0d6c1e-8a3b-4c2d-9e7f-1a2b3c4d5e6f",
      "uid": "3f9a1c0b7d2e4f6a8b1c3d5e7f9a0b2c",
      "roles": [
        "admin"
      ],
      "createdAt": "2026-10-21T10:00:00Z",
      "locale": "en",
      "languages": [
        "en",
        "de"
      ],
      "timeZone": "Europe/Zurich",
      "settings": {
        "briefSize": 12,
        "editions": [
          "morning",
          "midday",
          "evening"
        ],
        "somethingDifferent": true,
        "emphasis": "balanced",
        "openInReader": false,
        "summaryInList": true,
        "personalisedRanking": true,
        "historyRetentionDays": 90
      },
      "consent": {
        "aiProcessing": {
          "granted": true,
          "version": "2026-10"
        }
      },
      "onboarding": {
        "completedAt": "2026-10-21T10:05:00Z"
      },
      "minBuild": 0
    }
  ]
}
