{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvonment.github.io/my-news/api/schemas/SuggestionRequest.schema.json",
  "title": "SuggestionRequest",
  "description": "Draft (Phase 3; not registered before then). POST /me/suggestions request. 3 per ISO week.",
  "x-phase": "P3",
  "type": "object",
  "required": [
    "url"
  ],
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "url": "https://www.watson.ch/"
    }
  ]
}
