{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvonment.github.io/my-news/api/schemas/StatementsPut.schema.json",
  "title": "StatementsPut",
  "description": "Draft (Phase 3; not registered before then). PUT /me/statements request: replaces the member's own interest statements. Needs AI consent.",
  "x-phase": "P3",
  "type": "object",
  "required": [
    "statements"
  ],
  "properties": {
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "maxItems": 10
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "statements": [
        {
          "text": "Mehr Schweizer Politik"
        }
      ]
    }
  ]
}
